# Store this file outside the repository and restrict it to root (chmod 600).
CLOUDREWIND_KEY=replace-with-project-api-key

# Optional: a health endpoint reachable from this host.
CLOUDREWIND_HEALTH_URL=https://your-app.example/health

# Optional: count only running containers in this Docker Compose project.
CLOUDREWIND_DOCKER_PROJECT=eventease

# Optional: app-owned JSON route and its shared token. Keep the route local/private.
CLOUDREWIND_METRICS_URL=http://127.0.0.1:5000/cloudrewind/metrics
CLOUDREWIND_METRICS_TOKEN=replace-with-a-long-random-secret
