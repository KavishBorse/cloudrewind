PORT=5000
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5173
# Set DATABASE_URL to use PostgreSQL. Leave it blank for local SQLite development.
# DATABASE_URL=postgresql://cloudrewind:change-me@localhost:5432/cloudrewind
# PG_POOL_MAX=10
# Optional Groq API key for user-requested AI incident narratives. Keep this key server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# SQLite file override, used only when DATABASE_URL is blank.
CLOUDREWIND_DB_PATH=
# Optional AWS profile for the CloudWatch connection in local development.
# AWS_PROFILE=cloudrewind-dev
